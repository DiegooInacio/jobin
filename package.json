    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.24",
    "prettier": "3.7.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
