{
  "name": "jobin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.21.1 <23",
    "pnpm": "9.15.9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run build",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:test:up": "docker compose --profile test up -d --wait db-test",
    "db:test:down": "docker compose --profile test stop db-test",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "test:auth": "vitest run tests/auth",
    "test:profile": "vitest run tests/profile"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@next/env": "15.5.24",
    "drizzle-orm": "0.45.1",
    "pg": "8.16.3",
    "server-only": "0.0.1",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.89.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.24",
    "prettier": "3.7.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.8",
    "vitest": "4.0.18"
  }
}
