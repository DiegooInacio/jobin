# Apenas desenvolvimento local. Não reutilizar estas credenciais em produção.
POSTGRES_USER=jobin
POSTGRES_PASSWORD=jobin_local
POSTGRES_DB=jobin
POSTGRES_PORT=5433
POSTGRES_TEST_PORT=5434

DATABASE_URL=postgresql://jobin:jobin_local@127.0.0.1:5433/jobin
TEST_DATABASE_URL=postgresql://jobin:jobin_test_local@127.0.0.1:5434/jobin_test

# Projeto Supabase de desenvolvimento (Settings > API Keys / Connect).
# Use apenas a chave publishable, nunca service_role ou sb_secret_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
